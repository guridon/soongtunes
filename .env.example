# Copy to .env and fill in. `make env` generates random passwords for you.
NEO4J_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# OpenAI-compatible endpoints (vLLM). See infra/llm/README.md
LLM_BASE_URL=http://<gpu-host>:8200/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-oss-20b
EMBED_BASE_URL=http://<gpu-host>:8201/v1
EMBED_API_KEY=change-me
EMBED_MODEL=harrier-oss-v1-0.6b

NEO4J_URI=bolt://localhost:7687
POSTGRES_DSN=postgresql://stunes:change-me@localhost:5432/stunes
OPENSEARCH_URL=http://localhost:9200
GRAFANA_PASSWORD=change-me
